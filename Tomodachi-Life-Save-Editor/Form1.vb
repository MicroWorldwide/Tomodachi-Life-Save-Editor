                Next
                Writer.Position = Pagh1
                Writer.WriteUnicodeString(Text_pagh_1.Text)
            End If
            If valu_pagh_2.Value = 14 Then
                For i As Integer = 0 To 95
                    Writer.Position = Pagh2 + i
