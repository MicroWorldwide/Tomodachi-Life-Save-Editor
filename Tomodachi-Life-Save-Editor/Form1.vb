    Public Sub readmusic()
        Try
            Dim Reader As New PackageIO.Reader(savedataArc, PackageIO.Endian.Little)
            Reader.Position = &H17B6E4 + Accesspagh
            ValPagh1 = Reader.Position
            valu_pagh_1.Value = Reader.ReadByte
